  "samasa_rules": [
    {
      "type": "Tatpurusha",
      "description": "Second word dominant",
      "devvani_use": "Sub-property / Child class",
      "example": {
        "words": ["Rāma", "Putra"],
        "compound": "Rāmaputra",
        "transliteration": "Rāmaputra",
        "meaning": "Rama's son",
        "devvani_identifier": "Rāma.Putra"
      }
    },
    {
      "type": "Dvandva",
      "description": "Both words equal",
      "devvani_use": "Tuple or multiple return type",
      "example": {
        "words": ["Rāma", "Lakshmana"],
        "compound": "Rāmalakshmanau",
        "transliteration": "Rāmalakshmanau",
        "meaning": "Rama and Lakshmana",
        "devvani_identifier": "tuple(Rāma, Lakshmana)"
      }
    },
    {
      "type": "Bahuvrīhi",
      "description": "Third object implied",
      "devvani_use": "Alias / Mapping interface",
      "example": {
        "words": ["Pīta", "Ambar"],
        
        "compound": "Pītāmbara",
        "transliteration": "Pītāmbara",
        "meaning": "One wearing yellow clothes",
        "devvani_identifier": "mapping(Pīta, Ambar)"
      }
    },
    {
      "type": "Avyayībhāva",
      "description": "First word dominant",
      "devvani_use": "Modifier / Constant definition",
      "example": {
        "words": ["Yatha", "Śakti"],
        "compound": "Yathaśakti",
        "transliteration": "Yathaśakti",
        "meaning": "According to strength",
        "devvani_identifier": "const YATHA_SAKTI"
      }
    },
    {
      "type": "Karmadhāraya",
      "description": "Adjective-noun",
      "devvani_use": "Type annotation / Typed variable",
      "example": {
        "words": ["Nīla", "Utpala"],
        "compound": "Nīlotpala",
        "transliteration": "Nīlotpala",
        "meaning": "Blue lotus",
        "devvani_identifier": "var Nīla_Utpala"
      }
    }
  ],
