{
  "sandhi_rules": [
    {
      "name": "Savarna Dirgha",
      "sutra": "6.1.101",
      "description": "When two similar vowels (savarna) meet, they merge into a single long vowel.",
      "compiler_relevance": "Lexer must handle vowel merging; Parser must treat combined vowels as single tokens or handle them in the semantic analysis phase.",
      "devvani_syntax": "a + a = ā, i + i = ī, u + u = ū",
      "sanskrit_example": {
        "input": "vidyā + ālayah",
        "output": "vidyālayah",
        "transliteration": "vidyālayah",
        "meaning": "school"
      },
      "equivalent_in": {
        "python": "string concatenation and normalization",
        "rust": "String::push_str() and unicode normalization"
      }
    },

    
    {
      "name": "Guna",
      "sutra": "1.1.2",
      "description": "A vowel (i, u, r, l) is transformed into its Guna equivalent (e, o, ar, al).",
      "compiler_relevance": "Requires a mapping table for vowel transformations in the lexer.",
      "devvani_syntax": "i -> e, u -> o, r -> ar",
      "sanskrit_example": {
        "input": "upa + indrah",
        "output": "upendrah",
        "transliteration": "upendrah",
        "meaning": "Upendra (name)"
      },
      "equivalent_in": {
        "python": "mapping dict lookup",
        "rust": "HashMap<char, char> lookup"
      }
    },
    {
      "name": "Vrddhi",
      "sutra": "1.1.1",
      "description": "A vowel (i, u, r, l) or its Guna equivalent is transformed into its Vrddhi equivalent (ai, au, ār, āl).",
      "compiler_relevance": "Lexer transformation similar to Guna.",
      "devvani_syntax": "a + e = ai, a + o = au",
      "sanskrit_example": {
        "input": "ava + eti",
        "output": "avaiti",
        "transliteration": "avaiti",
        "meaning": "he knows"
      },
      "equivalent_in": {
        "python": "mapping dict lookup",
        "rust": "HashMap<char, char> lookup"
      }
    },
    {
      "name": "Yan Sandhi",
      "sutra": "6.1.77",
      "description": "Vowels (i, u, r, l) before a different vowel are replaced by their semi-vowels (y, v, r, l).",
      "compiler_relevance": "Parser requires lookahead to determine if a vowel should be replaced.",
      "devvani_syntax": "i -> y, u -> v, r -> r",
      "sanskrit_example": {
        "input": "iti + ādi",
        "output": "ityādi",
        "transliteration": "ityādi",
        "meaning": "etcetera"
      },
      "equivalent_in": {
        "python": "regex substitution",
        "rust": "regex::Regex::replace()"
      }
    },
    {
      "name": "Visarga Sandhi",
      "sutra": "8.3.15",
      "description": "Visarga (h) is modified or dropped based on the following sound.",
      "compiler_relevance": "Visarga needs to be treated as a special character in tokenization.",
      "devvani_syntax": "h + c = ś, h + t = s",
      "sanskrit_example": {
        "input": "namah + te",
        "output": "namaste",
        "transliteration": "namaste",
        "meaning": "salutations to you"
      },
      "equivalent_in": {
        "python": "conditional string modification",
        "rust": "match statement on Visarga token"
      }
    }
  ],
