# देववाणी - प्रथम तंत्रिका जाल कार्यक्रम
# Devvani First Neural Network Program

# आयात स्तर
# आयात प्रतिरूप
# आयात सक्रियण

# Define a simple neural network
क्रिया जालनिर्माण() {
    मान प्रतिरूप१: प्रतिरूप = प्रतिरूप("वर्गीकारक")
    मान स्तर१: स्तर = स्तर(784, 128, 1) # सक्रियण.रेलू -> 1
    मान स्तर२: स्तर = स्तर(128, 64, 1)
    मान स्तर३: स्तर = स्तर(64, 10, 2)   # सक्रियण.सॉफ्टमैक्स -> 2
    प्रत्यावर्तन प्रतिरूप१
}

# Training configuration
मान युग: पूर्णांक = 100
मान शिक्षणदर: दशमलव = 0
मान खंडआकार: पूर्णांक = 32

# Main execution
मान मेराजाल = जालनिर्माण()
मुद्रण("प्रतिरूप तैयार है")
मुद्रण("युग संख्या: 100")
मुद्रण("शिक्षण दर: 0.001")
मुद्रण("Devvani Neural Network Ready")
